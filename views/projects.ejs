<%- include partials/header.ejs %>
<%- include partials/main_nav.ejs %>
    <!--Main content-->
<main class="container">
    <div class="row">
        <div class="offset-md-1 col-md-10">
            <h1><%= title %></h1>
            <br>
            <table class="table table-bordered table-striped table-hover">
                <!--Header Row-->
                <tr>
                    <th class="text-center col-2">Project</th>
                    <th class="col-4">Description</th>
                </tr>
                <!-- one row for each project -->
                <% for(let count=0;count<Projectlist.length;count++) { %>
                    <tr>
                        <td class="text-center col-2"><%= Projectlist[count].name %></td>
                        <td class="col-4"><%= Projectlist[count].description %></td>
                    </tr>
                <%} %>
            </table>
        </div>
    </div>
</main>
<%- include partials/footer.ejs %>
